{
  "_comment": "Copy this file to .agents/mcp_config.json and enable the servers your project needs. Never commit .agents/mcp_config.json with real secrets — it is gitignored.",
  "mcpServers": {
    "_note_environment_mcps": {
      "_comment": "Antigravity provides built-in MCPs (shadcn, context7, chrome-devtools-mcp, playwright, Neon, awwwards). Only uncomment entries below if you are running in a harness without built-in servers or overriding configuration."
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@executeautomation/playwright-mcp-server"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "neon": {
      "command": "npx",
      "args": ["-y", "@neondatabase/mcp-server-neon", "start", "${NEON_API_KEY}"]
    }
  }
}
